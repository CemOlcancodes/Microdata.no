tabulate fylkes2020
tabulate fylkes2020 fylke2025
create-dataset telledager
import-event db/BOSATTEFDT_BOSTED 1991-12-31 to 2023-12-31 as norskbodd
replace STOP@norskbodd = date(2023,12,31) if STOP@norskbodd > date(2023,12,31)
replace START@norskbodd = date(1991,12,31) if START@norskbodd < date(1991,12,31)
generate dager = STOP@norskbodd - START@norskbodd + 1
collapse(sum) dager, by(PERSONID_1)
boxplot dager
summarize dager
histogram dager, width(30)
drop if sysmiss(dager)
clone-variables dager -> tidsintervaller
recode tidsintervaller (0= 0 'Ukjent') (1/1825 = 1 'Opp til 5 år') (1826/3650 = 2 '5-10 år') (3651/999999 = 3 'Mer enn 10 år')
tabulate tidsintervaller
// KEEP IF dager mindre enn feks 2 år? For Ukrainernes del?
merge tidsintervaller into new1
use new1

tabulate kom2020
tabulate kom2025
// Lage flytter variabel. 
generate flytter =0 if fylke2025 == fylkes2020 & sysmiss(fylke2025) == 0 & sysmiss(fylkes2020) == 0
replace flytter = 1 if fylke2025 != fylkes2020 & sysmiss(fylke2025) == 0 & sysmiss(fylkes2020) == 0
tabulate flytter, missing cellpct freq
// sankey-diagram viser hvor folk flyttet siden 2016
sankey fylkes2020 fylke2025 if flytter
//Importere uføre-variabel for 2016. Jeg vil bruke uføre fra 2021 i regresjonen.

tabulate fylkes2020 fylke2025 if flytter

import db/BEFOLKNING_INNGRUNN1 as invgrunn
tabulate invgrunn
keep if invgrunn == "FLU"
tabulate fylkes2020 fylke2025
tabulate fylkes2020 kom2025
