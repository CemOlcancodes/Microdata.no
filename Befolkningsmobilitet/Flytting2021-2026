create-dataset telledager
//siste datoen er 2024
import-event db/BOSATTEFDT_BOSTED 1991-12-31 to 2024-12-31 as norskbodd
replace STOP@norskbodd = date(2025,12,31) if STOP@norskbodd > date(2025,12,31)
